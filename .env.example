# Stripe — https://dashboard.stripe.com/apikeys
# Use sk_test_/pk_test_ while testing, sk_live_/pk_live_ in production.
# NEVER commit real keys. Set these in Vercel → Settings → Environment Variables.
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# Public site URL, used for canonical URLs, sitemap, JSON-LD and the GMC feed.
NEXT_PUBLIC_SITE_URL=https://thornstead-store-three.vercel.app

# Admin panel at /admin — password must be at least 8 characters.
# Optional username defaults to "admin". Optional ADMIN_SECRET signs the session cookie;
# if omitted, ADMIN_PASSWORD is used.
ADMIN_PASSWORD=change-me-please
ADMIN_USER=admin
# ADMIN_SECRET=
